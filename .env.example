# Copia este archivo como ".env" y ajusta los valores.
PORT=3000
HOST=127.0.0.1

# Enlace de conexión a MySQL/MariaDB (obligatorio):  mysql://usuario:clave@host:3306/base_de_datos
# Si la clave tiene caracteres especiales (@ : / # ?) escríbela codificada (ej. @ = %40).
# Añade ?ssl=true al final si tu proveedor exige conexión cifrada.
MYSQL_URL=mysql://usuario:clave@localhost:3306/wiki_ceje

# DeepSeek: permite crear módulos desde archivos Word (.docx).
# Crea la llave en https://platform.deepseek.com/api_keys y no la publiques.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Formato:  USUARIO_n=nombre:contraseña(mínimo 8 caracteres):rol   (rol: admin | editor)
USUARIO_1=admin:CAMBIA_ESTA_CLAVE:admin
USUARIO_2=editor:CAMBIA_ESTA_CLAVE_2:editor
